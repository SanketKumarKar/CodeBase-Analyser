# ==============================================================================
# Codebase Intelligence Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ==============================================================================

# ── Application ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development   # development | production
LOG_LEVEL=INFO

# ── Ollama (local LLM + embedding — runs on host, not in Docker) ───────────────
# On Docker Desktop (Windows/Mac), host.docker.internal resolves to the host.
# For native Linux Docker: use the host IP or set OLLAMA_HOST=0.0.0.0 in Ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma4:latest
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_EMBEDDING_DIM=2560      # qwen3-embedding:4b output dimension

# ── Mem0 Cloud (conversational memory) ────────────────────────────────────────
# Package: mem0ai (pip install mem0ai)
# Get your API key from: https://app.mem0.ai/
MEM0_API_KEY=m0-wU6utbrTnf6E9ikQ0JgL64iBgSTj7gqIqtVRpGPV

# ── Qdrant (vector database) ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                 # leave blank for local unauthenticated Qdrant
QDRANT_COLLECTION_NAME=codebase_chunks

# ── Neo4j AuraDB Cloud (graph database) ─────────────────────────────────────
# Create a free instance at: https://console.neo4j.io/
# URI format is neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password-here

# ── Redis (cache + Celery broker) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
EMBEDDING_CACHE_TTL=604800    # 7 days in seconds

# ── PostgreSQL (job tracking + metadata) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agent:changeme123@localhost:5432/codebase_agent
POSTGRES_DB=codebase_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme123

# ── Repository Ingestion Limits ───────────────────────────────────────────────
MAX_REPO_SIZE_MB=500
MAX_REPO_FILES=10000
REPO_CLONE_TIMEOUT_SECONDS=120
TEMP_REPO_DIR=/tmp/repos

# ── GitHub (optional — only needed for private repos) ─────────────────────────
GITHUB_TOKEN=                   # optional: ghp_xxxx for private repo access

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ─────────────────────────────────────────────────────────────
CHAT_RATE_LIMIT=20/minute       # applied to POST /chat/query

# ── Frontend (Next.js public vars — must prefix NEXT_PUBLIC_) ─────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
